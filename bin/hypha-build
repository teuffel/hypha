#!/usr/bin/env bash
#
# Hypha build pipeline.
#
# Two modes:
#
#   bin/hypha-build               compile-mode  (default; fast dev iteration)
#   bin/hypha-build --release     release-mode  (full prod pipeline)
#
# Compile-mode (M0-M2 default):
#   - clojure -M:cljs compile app db-worker  (with HYPHA-MODE define)
#   - A8 smoke (HYPHA_MODE in main.js)
#   - deps/db-sync build:node-adapter
#   - hypha-server tsc
#
# Release-mode (M3+; used by Dockerfile.hypha):
#   - pnpm install at repo root (vendor JS + tailwind + gulp + webpack deps)
#   - gulp:build (copy resources/ -> static/, build CSS)
#   - clojure -M:cljs release app db-worker db-worker-node  (HYPHA-MODE define)
#   - A8 smoke
#   - webpack-app-build (vendor JS bundling into static/js/)
#   - deps/db-sync build:node-adapter
#   - hypha-server tsc
#
# After release-mode, static/ holds a fully self-contained browser bundle
# that hypha-server can serve directly.
#
# Usage: bin/hypha-build [--release]

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

MODE="compile"
if [[ "${1:-}" == "--release" ]]; then
  MODE="release"
fi

if [[ "$MODE" == "release" ]]; then
  STEPS=7
  echo ">> Hypha build (release mode, $STEPS steps)"
else
  STEPS=4
  echo ">> Hypha build (compile mode, $STEPS steps)"
fi

step=0
next_step() {
  step=$((step + 1))
  echo
  echo ">> [$step/$STEPS] $1"
}

# ─── Release-only: root-level install + gulp ────────────────────────────────

if [[ "$MODE" == "release" ]]; then
  next_step "Installing root-level workspace dependencies (gulp/webpack/tailwind/...)"
  if [[ ! -d node_modules || ! -d packages/ui/node_modules ]]; then
    pnpm install
  else
    pnpm install --frozen-lockfile
  fi

  next_step "gulp:build (copy resources/ -> static/, build CSS)"
  pnpm gulp:build
fi

# ─── ClojureScript ───────────────────────────────────────────────────────────

if [[ "$MODE" == "release" ]]; then
  next_step "ClojureScript release build (app + db-worker + db-worker-node, HYPHA_MODE=true)"
  clojure -M:cljs release app db-worker db-worker-node \
    --config-merge '{:closure-defines {frontend.hypha.config/HYPHA-MODE true}}'
else
  next_step "ClojureScript compile (app + db-worker, HYPHA_MODE=true)"
  clojure -M:cljs compile app db-worker \
    --config-merge '{:closure-defines {frontend.hypha.config/HYPHA-MODE true}}'
fi

# ─── A8 smoke ────────────────────────────────────────────────────────────────

next_step "Verifying HYPHA_MODE propagation (A8 smoke-check)"
if [[ ! -f static/js/main.js ]]; then
  echo "FAIL: static/js/main.js not produced by CLJS build" >&2
  exit 1
fi

if [[ "$MODE" == "compile" ]]; then
  # Compile mode preserves the literal CLOSURE_DEFINES map. The string check
  # below is the authoritative A8 verification for the flag propagation
  # mechanism — release mode reuses the same --config-merge flag, so when
  # this check passes in compile mode the propagation works in release too.
  if ! grep -q '"frontend.hypha.config.HYPHA_MODE":true' static/js/main.js; then
    echo "FAIL: HYPHA_MODE define did not propagate into static/js/main.js" >&2
    echo "      Expected to see: \"frontend.hypha.config.HYPHA_MODE\":true" >&2
    echo "      In file:         static/js/main.js" >&2
    echo "      First CLOSURE_DEFINES line for inspection:" >&2
    grep -m1 'CLOSURE_DEFINES' static/js/main.js >&2 || true
    exit 1
  fi
  echo "   OK (CLOSURE_DEFINES map contains HYPHA_MODE=true)"
else
  # Release mode applies Closure advanced optimization, which inlines @define
  # values directly at usage sites + drops the CLOSURE_DEFINES map. We cannot
  # grep for the define literal. Instead we verify the bundle contains the
  # Hypha-specific runtime strings that only end up bundled because the
  # patches in handler.cljs + handler/events/ui.cljs reach into Hypha
  # namespaces — those strings (e.g. "/auth/session") would survive even with
  # HYPHA_MODE=false (the :require pulls in the namespace) but their presence
  # at least confirms the Hypha namespaces compiled cleanly into the bundle.
  missing=()
  for needle in '"/auth/login"' '"/auth/session"' 'cp__hypha-login'; do
    if ! grep -qF "$needle" static/js/main.js; then
      missing+=("$needle")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    echo "FAIL: release bundle missing Hypha runtime strings:" >&2
    printf '  %s\n' "${missing[@]}" >&2
    exit 1
  fi
  echo "   OK (Hypha runtime strings present; release-mode A8 is functional"
  echo "       — see hypha-server smoke in operations.md for runtime check)"
fi

# ─── Release-only: webpack ───────────────────────────────────────────────────

if [[ "$MODE" == "release" ]]; then
  next_step "webpack-app-build (vendor JS bundling)"
  pnpm webpack-app-build
fi

# ─── db-sync node-adapter ────────────────────────────────────────────────────

next_step "Building db-sync node-adapter (deps/db-sync)"
if [[ ! -d deps/db-sync/node_modules ]]; then
  pnpm --dir deps/db-sync install
else
  pnpm --dir deps/db-sync install --frozen-lockfile
fi
pnpm --dir deps/db-sync run build:node-adapter
if [[ ! -f deps/db-sync/worker/dist/node-adapter.js ]]; then
  echo "FAIL: deps/db-sync/worker/dist/node-adapter.js not produced" >&2
  exit 1
fi
echo "   OK"

# ─── hypha-server ────────────────────────────────────────────────────────────

next_step "Building hypha-server (TypeScript)"
if [[ ! -f hypha-server/pnpm-lock.yaml ]]; then
  pnpm --dir hypha-server install
else
  pnpm --dir hypha-server install --frozen-lockfile
fi
pnpm --dir hypha-server build

echo
echo ">> Hypha build complete ($MODE mode)."
echo "   Frontend:    static/js/main.js"
echo "   db-sync:     deps/db-sync/worker/dist/node-adapter.js"
echo "   Server:      hypha-server/dist/main.js"
if [[ "$MODE" == "release" ]]; then
  echo "   Statics:     static/  (full browser-loadable bundle)"
fi
