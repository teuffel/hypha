#!/usr/bin/env bash
#
# Hypha build pipeline.
#
# Builds the three Hypha artifacts:
#   1. ClojureScript frontend, with HYPHA-MODE=true via --config-merge.
#   2. db-sync node-adapter bundle (deps/db-sync/worker/dist/node-adapter.js).
#   3. hypha-server (TypeScript) → hypha-server/dist/main.js.
#
# Smoke-verifies that the HYPHA-MODE Closure define actually reached the
# compiled CLOSURE_DEFINES map (replay of the V4 verification, now automated).
#
# Output:
#   static/js/main.js                              -- Hypha frontend
#   deps/db-sync/worker/dist/node-adapter.js       -- db-sync server bundle
#   hypha-server/dist/main.js                      -- hypha-server runtime
#
# Future milestones:
#   M3: switch CLJS step to release mode for the Docker image; also pull in
#       `gulp:build` + `webpack-app-build` so the bundle the browser actually
#       loads (CSS, vendor JS, index.html) is produced.
#
# Usage: bin/hypha-build

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# --- Step 1: ClojureScript frontend ----------------------------------------

echo ">> [1/4] Building Hypha frontend (ClojureScript, compile mode)..."
clojure -M:cljs compile app db-worker \
  --config-merge '{:closure-defines {frontend.hypha.config/HYPHA-MODE true}}'

# --- Step 2: A8-Smoke (HYPHA-MODE propagation) -----------------------------

echo ">> [2/4] Verifying HYPHA-MODE propagation (A8 smoke-check)..."
if [[ ! -f static/js/main.js ]]; then
  echo "FAIL: static/js/main.js not produced by CLJS build" >&2
  exit 1
fi

if ! grep -q '"frontend.hypha.config.HYPHA_MODE":true' static/js/main.js; then
  echo "FAIL: HYPHA_MODE define did not propagate into static/js/main.js" >&2
  echo "      Expected to see: \"frontend.hypha.config.HYPHA_MODE\":true" >&2
  echo "      In file:         static/js/main.js" >&2
  echo "      First CLOSURE_DEFINES line for inspection:" >&2
  grep -m1 'CLOSURE_DEFINES' static/js/main.js >&2 || true
  exit 1
fi
echo "   OK"

# --- Step 3: db-sync node-adapter bundle -----------------------------------

echo ">> [3/4] Building db-sync node-adapter (deps/db-sync)..."
if [[ ! -d deps/db-sync/node_modules ]]; then
  echo "   No node_modules in deps/db-sync, running first install..."
  pnpm --dir deps/db-sync install
else
  pnpm --dir deps/db-sync install --frozen-lockfile
fi
pnpm --dir deps/db-sync run build:node-adapter

if [[ ! -f deps/db-sync/worker/dist/node-adapter.js ]]; then
  echo "FAIL: deps/db-sync/worker/dist/node-adapter.js not produced" >&2
  exit 1
fi
echo "   OK"

# --- Step 4: hypha-server build (TypeScript) -------------------------------

echo ">> [4/4] Building hypha-server (TypeScript)..."
if [[ ! -f hypha-server/pnpm-lock.yaml ]]; then
  echo "   No lockfile yet, running first install (no --frozen-lockfile)..."
  pnpm --dir hypha-server install
else
  pnpm --dir hypha-server install --frozen-lockfile
fi
pnpm --dir hypha-server build

echo
echo ">> Hypha build complete."
echo "   Frontend:    static/js/main.js"
echo "   db-sync:     deps/db-sync/worker/dist/node-adapter.js"
echo "   Server:      hypha-server/dist/main.js"
