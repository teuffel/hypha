{
  "name": "@hypha/server",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Hypha self-hostable server: reverse-proxy + auth + statics for a Hypha-built Logseq frontend",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:headless-auth": "playwright test",
    "test:install-browsers": "playwright install chromium",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/http-proxy": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "bcryptjs": "^3.0.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
