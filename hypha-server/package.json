{
  "name": "@hypha/server",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Hypha self-hostable server: reverse-proxy + auth + statics for a Hypha-built Logseq frontend",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
