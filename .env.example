# Hypha environment template.
#
# Copy to `.env` (gitignored) and edit. Required values are marked REQUIRED.

# ── REQUIRED ──────────────────────────────────────────────────────────────
# bcrypt-hashed access code. Generate with:
#
#   bin/hypha-gen-access-hash
#
# The output line is ready to paste here verbatim. The single quotes are
# REQUIRED: bcrypt hashes contain '$' which docker-compose otherwise
# interprets as variable references.
HYPHA_ACCESS_CODE_HASH=''

# ── OPTIONAL ──────────────────────────────────────────────────────────────

# Public URL for JWT iss claim. When fronting Hypha with a reverse proxy
# (Caddy, nginx, Traefik) on a public hostname, set this to the same value
# the browser sees so JWT verification stays consistent.
HYPHA_JWT_ISSUER=http://localhost:3000

# JWT aud claim. Any non-empty string; only used by node-adapter to verify
# tokens against itself.
HYPHA_JWT_AUDIENCE=hypha

# Secure attribute on the session cookie. Leave unset: it follows the
# scheme of HYPHA_JWT_ISSUER (https -> on). Set "false" only for plain-HTTP
# access on a LAN.
#HYPHA_COOKIE_SECURE=

# Issued-JWT lifetime. jose duration string ("30d", "12h", "60m").
HYPHA_JWT_TTL=30d

# Host port to publish hypha-server on. Default 3000.
HYPHA_HOST_PORT=3000

# Host address the port is published on. Default 127.0.0.1: reachable only
# from this machine, i.e. through a reverse proxy running here. Set 0.0.0.0
# for LAN access without a proxy, or when the proxy runs on another host.
#HYPHA_BIND=0.0.0.0

# ── Plugin origin ─────────────────────────────────────────────────────────
# Marketplace plugins run third-party code in iframes. Hypha serves those
# iframe documents from a SECOND origin so plugin code cannot read your
# Hypha session. Two ways to give it one:
#
# (a) Second port (default, zero-config for localhost / LAN):
#     host port to publish the plugin-assets listener on.
HYPHA_PLUGIN_HOST_PORT=3010
#
# (b) Own hostname behind a TLS reverse proxy (recommended for internet
#     exposure): route e.g. https://plugins.hypha.example.com to container
#     port 3010 and set the public origin here. Must differ from the app's
#     origin; hypha-server refuses to start otherwise.
#HYPHA_PLUGIN_ORIGIN=https://plugins.hypha.example.com
