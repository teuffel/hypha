# Hypha environment template.
#
# Copy to `.env` (gitignored) and edit. Required values are marked REQUIRED.

# ── REQUIRED ──────────────────────────────────────────────────────────────
# bcrypt-hashed access code. Generate with:
#
#   bin/hypha-gen-access-hash
#
# The output line is ready to paste here verbatim. The single quotes are
# REQUIRED: bcrypt hashes contain '$' which docker-compose otherwise
# interprets as variable references.
HYPHA_ACCESS_CODE_HASH=''

# ── OPTIONAL ──────────────────────────────────────────────────────────────

# Public URL for JWT iss claim. When fronting Hypha with a reverse proxy
# (Caddy, nginx, Traefik) on a public hostname, set this to the same value
# the browser sees so JWT verification stays consistent.
HYPHA_JWT_ISSUER=http://localhost:3000

# JWT aud claim. Any non-empty string; only used by node-adapter to verify
# tokens against itself.
HYPHA_JWT_AUDIENCE=hypha

# Set to "true" when the reverse proxy enforces https. The session cookie
# will then carry the Secure attribute, denying it to any plain-http access.
HYPHA_COOKIE_SECURE=false

# Issued-JWT lifetime. jose duration string ("30d", "12h", "60m").
HYPHA_JWT_TTL=30d

# Host port to publish hypha-server on. Default 3000.
HYPHA_HOST_PORT=3000
